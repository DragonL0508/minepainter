    <PackageReference Include="SkiaSharp" Version="2.88.9" />
    <!-- AI 去背：ONNX Runtime（DirectML 版含 CPU provider，GPU 可選）；模型不隨 app 附帶 -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.24.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- HistoryManager.Undo/Redo/JumpTo 是 internal（UI 必須走 EditorSession），測試要直接驗它 -->
    <InternalsVisibleTo Include="MinePainter.Core.Tests" />
  </ItemGroup>

</Project>
