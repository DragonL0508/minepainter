<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" Exclude="Assets\Sounds\**;Assets\Native\**" />
    <!-- 啟動音效：內嵌資源（啟動畫面出現時 Avalonia 尚未初始化，不能走 avares） -->
    <EmbeddedResource Include="Assets\Sounds\*.wav" />
    <!--
      小工具「YouTube 縮圖預覽」的週邊影片縮圖：檔名＝影片標題（見該資料夾的 README）。
      LogicalName 保留原檔名（含中文），程式靠 ytthumb/ 前綴掃出來；沒放圖也編得起來。
    -->
    <EmbeddedResource Include="Assets\YouTubePreview\*.webp"
                      LogicalName="ytthumb/%(Filename)%(Extension)" />
    <!--
      檔案總管的 .mpp 縮圖處理常式：publish.bat 會先把 MinePainter.Thumbnails 用
      NativeAOT 編成原生 DLL 放到這裡，再嵌進 exe（發佈的仍然是單一檔案），安裝時
      才寫進安裝資料夾並註冊。開發建置沒有這個檔，條件式讓它照樣編得起來。
    -->
    <EmbeddedResource Include="Assets\Native\MinePainterThumbs.dll"
                      LogicalName="MinePainterThumbs.dll"
                      Condition="Exists('$(MSBuildThisFileDirectory)Assets\Native\MinePainterThumbs.dll')" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.20" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.20" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.20" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.20" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.20" Condition="'$(Configuration)' == 'Debug'" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Material.Icons.Avalonia" Version="2.1.10" />
    <!-- net8.0（非 -windows）沒有登錄檔 API；檔案關聯只寫 HKCU 需要它 -->
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MinePainter.Core\MinePainter.Core.csproj" />
  </ItemGroup>

</Project>
