<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="using:MinePainter.App"
             x:Class="MinePainter.App.Views.LayersPanel">

  <DockPanel>
    <!-- 操作列（icon-only，樣式比照工具面板；內容由 code-behind 建立以便用 MaterialIcon） -->
    <Border DockPanel.Dock="Bottom" Margin="0,6,0,0" Padding="3"
            Background="{x:Static app:AppTheme.ChromeBrush}" CornerRadius="4">
      <StackPanel x:Name="ActionBar" Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center" />
    </Border>

    <!-- 填滿面板剩餘高度（面板視窗可拉大小），內部捲動；圖層數量不影響視窗尺寸。
         Overlay 畫拖曳排序的插入線（座標系與 ListBox 相同）。 -->
    <Panel>
      <!-- 多選：Ctrl 點＝加減選、Shift 點＝連選、空白處拖曳＝框選；作用中圖層永遠是選取裡的一個 -->
      <ListBox x:Name="LayerList" SelectionChanged="OnSelectionChanged" SelectionMode="Multiple"
               Background="{x:Static app:AppTheme.InnerBrush}"
               MinHeight="80" ScrollViewer.VerticalScrollBarVisibility="Auto"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
      <Canvas x:Name="DragOverlay" IsHitTestVisible="False">
        <!-- 拖曳中的那一列本身：抓起來跟著指標走（插入線只說「會放在哪」） -->
        <Border x:Name="DragGhost" IsVisible="False" Opacity="0.85" CornerRadius="4" ClipToBounds="True"
                BorderBrush="{x:Static app:AppTheme.AccentBrush}" BorderThickness="1"
                Background="{x:Static app:AppTheme.PanelBrush}">
          <Panel>
            <Image x:Name="DragGhostImage" />
            <!-- 一次拖好幾層：抓在手上的只畫按住的那一列，右上角標「×N」 -->
            <Border x:Name="DragGhostCount" IsVisible="False" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,3,6,0" Padding="6,1" CornerRadius="8" Background="{x:Static app:AppTheme.AccentBrush}">
              <TextBlock x:Name="DragGhostCountText" FontSize="11" FontWeight="Bold" Foreground="White" />
            </Border>
          </Panel>
        </Border>
        <!-- 空白處拖出來的框選範圍 -->
        <Border x:Name="Marquee" IsVisible="False" BorderThickness="1" CornerRadius="2"
                BorderBrush="{x:Static app:AppTheme.AccentBrush}" Background="#302A9DF4" />
        <Border x:Name="DropIndicator" Height="3" Background="{x:Static app:AppTheme.AccentBrush}" CornerRadius="1.5" IsVisible="False" />
      </Canvas>
    </Panel>
  </DockPanel>
</UserControl>
